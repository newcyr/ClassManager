<Window x:Class="ClassManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="班级管理小师" Width="1100" Height="760" MinWidth="960" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="班级管理小师" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="上课闹钟 · 全屏提醒 · 希沃自动登录　｜　后台常驻，非上课时间全程静默"
                               FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="测试全屏提醒" Click="BtnTestAlarm_Click" />
                    <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Padding="22,8"
                            Click="BtnSave_Click" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="16,12,16,4" Background="Transparent" BorderThickness="0">
            <!-- 课程表 -->
            <TabItem Header="课程表">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="我的课程表" FontWeight="Bold" FontSize="15" Margin="0,0,0,8" />
                            <ListBox x:Name="ListTimetables" Height="190" DisplayMemberPath="Name"
                                     SelectionChanged="ListTimetables_SelectionChanged" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="新建" Click="BtnNewTimetable_Click" />
                                <Button Content="删除" Click="BtnDeleteTimetable_Click" />
                            </StackPanel>

                            <Separator Margin="0,14" />
                            <TextBlock Text="重命名当前课程表" FontWeight="Bold" Margin="0,0,0,6" />
                            <TextBox x:Name="TxtTimetableName" />
                            <Button Content="应用名称" Click="BtnRenameTimetable_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />

                            <Separator Margin="0,14" />
                            <TextBlock Text="周几 → 使用哪张课程表" FontWeight="Bold" Margin="0,0,0,4" />
                            <TextBlock Text="例如：周一至周六用课程表A，周日用课程表B" FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <StackPanel x:Name="WeekMapPanel" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock x:Name="TxtCurrentTimetable" Text="当前课程表" FontWeight="Bold" FontSize="15" />
                                <TextBlock Text="每节课只设置上课时间（无下课时间）。时间格式 HH:mm，提前 N 分钟响铃。"
                                           FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,0" />
                            </StackPanel>

                            <DataGrid x:Name="GridEntries" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                      CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="上课时间(HH:mm)" Width="130" Binding="{Binding Time, UpdateSourceTrigger=LostFocus}" />
                                    <DataGridTemplateColumn Header="科目" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox IsEditable="True"
                                                          ItemsSource="{Binding DataContext.SubjectOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="2,2" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="提前(分钟)" Width="110" Binding="{Binding AdvanceMinutes, UpdateSourceTrigger=LostFocus}" />
                                    <DataGridTextColumn Header="备注" Width="*" Binding="{Binding Note, UpdateSourceTrigger=LostFocus}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="添加课程" Click="BtnAddEntry_Click" />
                                <Button Content="删除选中" Click="BtnDeleteEntry_Click" />
                                <Button Content="按默认分钟数填充提前量" Click="BtnApplyDefaultAdvance_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 闹钟 -->
            <TabItem Header="闹钟">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="独立闹钟" FontWeight="Bold" FontSize="15" />
                                <TextBlock Text="用于上课以外的提醒（例如到校、集会）。与课程表互不影响。"
                                           FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <DataGrid x:Name="GridAlarms" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                      CanUserDeleteRows="False" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间(HH:mm)" Width="130" Binding="{Binding Time, UpdateSourceTrigger=LostFocus}" />
                                    <DataGridTextColumn Header="名称" Width="*" Binding="{Binding Label, UpdateSourceTrigger=LostFocus}" />
                                    <DataGridTextColumn Header="提前(分钟)" Width="110" Binding="{Binding AdvanceMinutes, UpdateSourceTrigger=LostFocus}" />
                                    <DataGridCheckBoxColumn Header="启用" Width="70" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="新增闹钟" Click="BtnAddAlarm_Click" />
                                <Button Content="删除选中" Click="BtnDeleteAlarm_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="闹钟铃声" FontWeight="Bold" FontSize="15" />
                            <TextBlock Text="支持 .mp3 / .wav；留空则使用内置铃声。到点后全屏响铃约 15 秒，点击屏幕 3 秒后关闭。"
                                       FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,8" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="TxtRingtone" Width="560" IsReadOnly="True" />
                                <Button Content="浏览…" Click="BtnBrowseRingtone_Click" Margin="10,0,8,0" />
                                <Button Content="试听" Click="BtnPreviewRingtone_Click" />
                                <Button Content="恢复内置" Click="BtnClearRingtone_Click" />
                            </StackPanel>
                            <TextBlock Text="紧急关闭热键：Ctrl + Alt + Shift + Q（全屏提醒显示期间生效）"
                                       FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 定时网页 -->
            <TabItem Header="定时网页">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="2,0,0,8" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"
                               TextWrapping="Wrap"
                               Text="到开始时间用系统默认浏览器打开网页，到结束时间自动关闭。时间跨天时结束时间早于开始时间即可。" />

                    <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <DataGrid x:Name="GridSmartUrls" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Width="110" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                                <DataGridTextColumn Header="网址" Width="*" Binding="{Binding Url, UpdateSourceTrigger=LostFocus}" />
                                <DataGridTextColumn Header="开始" Width="70" Binding="{Binding StartTime, UpdateSourceTrigger=LostFocus}" />
                                <DataGridTextColumn Header="结束" Width="70" Binding="{Binding EndTime, UpdateSourceTrigger=LostFocus}" />
                                <DataGridTemplateColumn Header="重复" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding Repeat, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Tag" Margin="2" MinWidth="70">
                                                <ComboBoxItem Content="每天" Tag="daily" />
                                                <ComboBoxItem Content="单次" Tag="once" />
                                                <ComboBoxItem Content="每周" Tag="weekly" />
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="单次日期" Width="100" Binding="{Binding Date, UpdateSourceTrigger=LostFocus}" />
                                <DataGridTemplateColumn Header="周起" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedIndex="{Binding WeekStart, UpdateSourceTrigger=PropertyChanged}" Margin="2" MinWidth="55">
                                                <ComboBoxItem Content="周一" />
                                                <ComboBoxItem Content="周二" />
                                                <ComboBoxItem Content="周三" />
                                                <ComboBoxItem Content="周四" />
                                                <ComboBoxItem Content="周五" />
                                                <ComboBoxItem Content="周六" />
                                                <ComboBoxItem Content="周日" />
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="周止" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedIndex="{Binding WeekEnd, UpdateSourceTrigger=PropertyChanged}" Margin="2" MinWidth="55">
                                                <ComboBoxItem Content="周一" />
                                                <ComboBoxItem Content="周二" />
                                                <ComboBoxItem Content="周三" />
                                                <ComboBoxItem Content="周四" />
                                                <ComboBoxItem Content="周五" />
                                                <ComboBoxItem Content="周六" />
                                                <ComboBoxItem Content="周日" />
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridCheckBoxColumn Header="启用" Width="56" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="新增网页" Click="BtnAddSmartUrl_Click" />
                        <Button Content="删除选中" Click="BtnDeleteSmartUrl_Click" />
                        <Button Content="立即测试选中" Click="BtnTestSmartUrl_Click" />
                        <Button Content="全部关闭" Click="BtnCloseSmartUrls_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 设置 -->
            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="科目管理" FontWeight="Bold" FontSize="15" />
                                    <TextBlock Text="内置初一常见科目，可新增 / 删除；课程表与希沃账号共用该列表。"
                                               FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,8" TextWrapping="Wrap" />
                                    <ListBox x:Name="ListSubjects" Height="180" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBox x:Name="TxtNewSubject" Width="150" />
                                        <Button Content="添加科目" Click="BtnAddSubject_Click" Margin="8,0,8,0" />
                                        <Button Content="删除选中" Click="BtnDeleteSubject_Click" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="上课条目默认提前分钟数" FontWeight="Bold" FontSize="15" />
                                    <TextBlock Text="新建上课条目时自动带入该值，仍可逐条单独修改。"
                                               FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,8" />
                                    <TextBox x:Name="TxtDefaultAdvance" Width="120" HorizontalAlignment="Left" />
                                    <CheckBox x:Name="ChkAlarmEnabled" Content="启用上课闹钟（关闭后不响铃）"
                                              Margin="0,18,0,0" VerticalContentAlignment="Center" />
                                    <CheckBox x:Name="ChkSeewoLogin" Content="闹钟触发后自动执行希沃登录（按当堂科目）"
                                              Margin="0,10,0,0" VerticalContentAlignment="Center" />
                                    <CheckBox x:Name="ChkAutoStart" Content="开机自动启动（后台托盘，不弹窗）"
                                              Margin="0,10,0,0" VerticalContentAlignment="Center" />
                                    <TextBlock Text="本版本已关闭自动更新功能，程序不会联网检查或下载新版本。"
                                               FontSize="11" Foreground="{StaticResource SubtleTextBrush}"
                                               TextWrapping="Wrap" Margin="0,14,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="希沃账号（按科目）" FontWeight="Bold" FontSize="15" />
                                <TextBlock Text="密码使用 Windows DPAPI 加密存储，不明文落盘。上课铃响后自动检测登录状态、必要时退出上一账号并登录当堂老师账号；失败静默处理。"
                                           FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,10" TextWrapping="Wrap" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="科目" FontWeight="Bold" Foreground="{StaticResource SubtleTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="希沃账号" FontWeight="Bold" Foreground="{StaticResource SubtleTextBrush}" />
                                    <TextBlock Grid.Column="2" Text="密码" FontWeight="Bold" Foreground="{StaticResource SubtleTextBrush}" />
                                </Grid>
                                <ItemsControl x:Name="AccountList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Subject}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Margin="0,0,10,0"
                                                         Text="{Binding Account, UpdateSourceTrigger=PropertyChanged}" />
                                                <PasswordBox Grid.Column="2" Loaded="PwdBox_Loaded"
                                                             PasswordChanged="PwdBox_PasswordChanged" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="希沃登录自检（后台执行，不弹窗）" HorizontalAlignment="Left"
                                        Margin="0,12,0,0" Click="BtnTestSeewo_Click" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="课程表 JSON" FontWeight="Bold" FontSize="15" />
                                <TextBlock Text="手动填写与 JSON 导入字段完全一致；导出默认不包含密码。字段说明见 docs/sdk.md。"
                                           FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,10" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="导入 JSON…" Click="BtnImport_Click" />
                                    <Button Content="导出 JSON…" Click="BtnExport_Click" />
                                    <Button Content="打开数据目录" Click="BtnOpenDataDir_Click" />
                                    <Button Content="打开使用说明页" Click="BtnOpenGuide_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="4,18,0,14">
                            <TextBlock Text="版权所有 (C) 2026 陈运然。保留所有权利。" FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock Text="Copyright (c) 2026 Chen Yun ran. All rights reserved." FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}" Margin="0,3,0,0" />
                            <TextBlock Text="依据 MIT 许可证授权。Licensed under the MIT License." FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}" Margin="0,3,0,0" />
                            <TextBlock Text="E-mail: cyrcyrgo@outlook.com  或  yjs_cla@126.com" FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                <TextBlock x:Name="NextText" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"
                           Foreground="{StaticResource SubtleTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
